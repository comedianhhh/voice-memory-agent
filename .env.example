# Copy to .env. Everything defaults to local, free services.
# SPEECH_URL=http://127.0.0.1:8880/v1
# OLLAMA_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:8b
# TTS_PROVIDER=kokoro          # or elevenlabs (paste your own key below)
# ELEVEN_API_KEY=

# Phone calls (optional): LiveKit Cloud project keys, from cloud.livekit.io -> Settings -> Keys.
# LIVEKIT_URL=wss://<your-project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# AGENT_NAME=voice-memory-agent   # the dispatch rule must name this agent
# PHONE_MEMORY_MODE=prefetch
